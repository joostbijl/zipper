    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict><key>default</key><string>Add to Archive with Zipper</string></dict>
            <key>NSMessage</key>
            <string>addToArchiveService</string>
            <key>NSPortName</key>
            <string>Zipper</string>
            <key>NSSendFileTypes</key>
